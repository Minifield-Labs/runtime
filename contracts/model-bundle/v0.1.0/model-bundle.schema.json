{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minifield:model-bundle:0.1.0",
  "title": "Minifield model-bundle 0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "purpose": {
      "enum": [
        "contract_fixture",
        "model_release"
      ]
    },
    "product_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "product_version": {
      "type": "string",
      "minLength": 1
    },
    "base_model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "training": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "run_id",
        "dataset_id",
        "dataset_manifest_sha256"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "weight_format": {
          "type": "string",
          "minLength": 1
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "weight_format",
        "quantization"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "context_tokens",
        "max_tool_calls",
        "max_output_tokens"
      ],
      "additionalProperties": false
    },
    "decoding": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "top_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "temperature",
        "top_p"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "weights",
              "tokenizer",
              "chat_template",
              "product_contract",
              "adapter",
              "runtime_config"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_][A-Za-z0-9_.-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "purpose",
    "product_id",
    "product_version",
    "base_model",
    "training",
    "engine",
    "limits",
    "decoding",
    "files"
  ],
  "additionalProperties": false
}
